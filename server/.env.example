# -- S.A.G.E server settings --
# APP_NAME=sage
# ENVIRONMENT=development
# DEBUG=false
# LOG_LEVEL=INFO
# CORS_ORIGINS=["http://localhost:5173"]

# required — your Neon (or any Postgres) connection string
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# required for running pytest — must be a separate test database
TEST_DATABASE_URL=postgresql+asyncpg://user:password@host/sage_test?ssl=require

# required — secret key for signing auth tokens (e.g. openssl rand -hex 32)
JWT_SECRET=supersecretkeyreplaceinproduction

# algorithm used for JWT signatures
JWT_ALGORITHM=HS256

# token expiration window in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -- LLM providers (a provider is enabled only when its key is set) --
OPENAI_API_KEY=
# example for groq (any openai-compatible api works):
# OPENAI_PROVIDER_NAME=groq
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODELS=["openai/gpt-oss-20b","openai/gpt-oss-120b"]
GEMINI_API_KEY=
# GEMINI_MODELS=["gemini-3.5-flash","gemini-flash-lite-latest"]

# offline "sage-echo" model for local dev, set to false in production
ENABLE_ECHO_MODEL=true

# -- gateway --
# DEFAULT_MODEL=auto
# FALLBACK_MODELS=["openai/gpt-oss-120b","gemini-flash-lite-latest"]
# LLM_TIMEOUT_SECONDS=60            # per http call to a provider
# LLM_IDLE_TIMEOUT_SECONDS=60       # max silence between two chunks (0 = off)
# LLM_TOTAL_TIMEOUT_SECONDS=300     # whole request incl. retries (0 = off)
# LLM_MAX_RETRIES=2
# CIRCUIT_BREAKER_THRESHOLD=5
# CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
# SYSTEM_PROMPT="You are Sage, a helpful and concise AI assistant."

# -- auto router (pick model "auto" to use it) --
# ROUTER_SIMPLE_MODEL=openai/gpt-oss-20b
# ROUTER_COMPLEX_MODEL=gemini-3.5-flash
# ROUTER_THRESHOLD=3
# ROUTER_LONG_PROMPT_CHARS=800
# ROUTER_KEYWORDS=["step by step","explain why","debug","design"]

# -- per-user daily quotas, reset at 00:00 UTC (0 = unlimited) --
# DAILY_REQUEST_QUOTA=200
# DAILY_TOKEN_QUOTA=200000
